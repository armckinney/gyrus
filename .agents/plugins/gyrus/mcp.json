{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "gyrus": {
      "args": [
        "run",
        "-i",
        "--rm",
        "-v",
        "/workspaces/gyrus:/workspace",
        "-w",
        "/workspace",
        "ghcr.io/armckinney/gyrus:latest",
        "mcp",
        "serve"
      ],
      "command": "docker",
      "type": "stdio"
    }
  }
}